@using Coditech.ViewModel
@model UserMasterViewModel
@{
    ViewBag.Title = Model.UserMasterId > 0 ? "View Details" : "";
    string actionName = ViewContext.Controller.ValueProvider.GetValue("action").RawValue.ToString();
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
}
<div class="container-fluid add-product-wrapper main-content-wrapper mt-4">
    <div class="row">
        <div class="col-lg-1"></div>
        <div class="col-lg-12 d-flex align-items-center justify-content-center right-side">
            <div class="list-wrapper">
                <div class="align-items-center d-flex justify-content-between wrapper-header mb-3">
                    @if (Model.UserMasterId > 0)
                    {
                        <h1 class="text-center font-poppins">Update User</h1>
                    }
                    else
                    {
                        <h1 class="text-center font-poppins">Add New User</h1>
                    }
                    <div class="align-items-center d-flex justify-content-between gap-10">
                        <a class="btn btn-set-default add-new-product base-font-size" href="../@controllerName/List">
                            <i class="fa fa-arrow-circle-left" aria-hidden="true"></i> Back
                        </a>
                    </div>
                </div>
                <div class="form-wrapper">

                    <div class="row">
                        <div class="col-lg-4">
                            <div class="mb-3">

                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.FirstName, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.FirstName)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.MiddleName, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.MiddleName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.MiddleName)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.LastName, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.LastName)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.DOB, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.DOB, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                @Html.ValidationMessageFor(x => x.DOB)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.Nationality, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.Nationality, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                @Html.ValidationMessageFor(x => x.Nationality)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.UniqueNumber, new { @class = "form-label required" })
                                @Html.TextBoxFor(x => x.UniqueNumber, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                @Html.ValidationMessageFor(x => x.UniqueNumber)
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="mb-3">
                                @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                <div class="form-check">
                                    @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-lg-4">
                        <div class="col-lg-12 mb-4 mb-lg-0">
                            @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form form-horizontal", id = "frmUserMaster" }))
                            {
                                <div class="col-lg-4">
                                    <div class="mb-3">

                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.FirstName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.FirstName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.MiddleName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.MiddleName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.MiddleName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.LastName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.LastName)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.DOB, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.DOB, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                        @Html.ValidationMessageFor(x => x.DOB)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.Nationality, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.Nationality, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                        @Html.ValidationMessageFor(x => x.Nationality)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.UniqueNumber, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.UniqueNumber, new { @class = "form-control", onkeypress = "return CoditechCommon.AllowOnlyAlphabetWithouSpacing()" })
                                        @Html.ValidationMessageFor(x => x.UniqueNumber)
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.IsActive, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                @Html.HiddenFor(x => x.UserMasterId)
                                <div class="col-lg-12 mb-4">
                                    <div class="col-lg-3">
                                        <label for="product-name" class="form-label">First Name<span class="required">*</span> :</label>
                                        <div class="form-box mb-4">
                                            @if (Model.UserMasterId > 0)
                                            {
                                                @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
                                            }
                                            @Html.ValidationMessageFor(x => x.FirstName, null, new { @class = "red" })
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <label for="product-name" class="form-label">Middle Name<span class="required">*</span> :</label>
                                        <div class="form-box mb-4">
                                            @if (Model.UserMasterId > 0)
                                            {
                                                @Html.TextBoxFor(x => x.MiddleName, new { @class = "form-control", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(x => x.MiddleName, new { @class = "form-control" })
                                            }
                                            @Html.ValidationMessageFor(x => x.MiddleName, null, new { @class = "red" })
                                        </div>
                                    </div>
                                    <div class="col-lg-3 mb-5">
                                        <label for="product-name" class="form-label">Last Name<span class="required">*</span> :</label>
                                        <div class="form-box mb-4">
                                            @if (Model.UserMasterId > 0)
                                            {
                                                @Html.TextBoxFor(x => x.LastName, new { @class = "form-control", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
                                            }
                                            @Html.ValidationMessageFor(x => x.LastName, null, new { @class = "red" })
                                        </div>
                                    </div>
                                    <div class="form-item-wrapper mb-5">
                                        <label for="product-name" class="form-label">Roles<span class="required">*</span> :</label>
                                        <div class="form-box mb-4">
                                            @Html.DropDownListFor(model => model.AdminRoleMasterId, Model.AdminRoleMasterList, "--Select--", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => x.AdminRoleMasterId, null, new { @class = "red" })
                                        </div>
                                    </div>

                                    <div class="form-item-wrapper mb-5">
                                        <div class="custom-control custom-checkbox">
                                            @Html.CheckBoxFor(x => x.IsActive, new { @class = "custom-control-input", @id = "isActive" })
                                            <label class="custom-control-label base-font-size" for="isActive">Is Active</label>
                                        </div>
                                    </div>
                                    <div class="form-item-wrapper mb-5">
                                        <div class="custom-control custom-checkbox">
                                            @Html.CheckBoxFor(x => x.IsDocumentApprovalAuthority, new { @class = "custom-control-input", @id = "IsDocumentApprovalAuthority" })
                                            <label class="custom-control-label base-font-size" for="IsDocumentApprovalAuthority">Is Document Approval Authority</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="align-items-center d-flex form-action justify-content-center">
                                    <button type="submit" class="btn login-btn btn-set-default">Save</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-1"></div>
    </div>
</div>