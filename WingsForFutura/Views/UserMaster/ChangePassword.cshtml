@using Coditech.ViewModel
@model UserMasterViewModel
@{
    ViewBag.Title = "Change Password";
    string actionName = ViewContext.Controller.ValueProvider.GetValue("action").RawValue.ToString();
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
}
<div class="container login-page-wrapper">
    <div class="row vh-100 d-flex justify-content-center">
        <div class="col-12 align-self-center">
            <div class="row">
                <div class="col-lg-5 mx-auto">
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center justify-content-between">
                                <div class="col-auto">
                                    <h4 class="card-title mb-0">Change Password</h4>
                                </div>
                                <div class="col-auto">
                                    <a class="btn btn-set-default add-new-product base-font-size" href="../@controllerName/List">
                                        <i class="fa fa-arrow-circle-left" aria-hidden="true"></i> Back
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0 auth-content">
                            <div class="tab-content">
                                <div class="tab-pane active p-3" id="LogIn_Tab" role="tabpanel">
                                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <!-- Current Password (no toggle) -->
                                        <div class="form-group mb-2">
                                            <label for="currentpassword" class="form-label">Current Password<span class="required">&nbsp;*</span> </label>
                                            <div class="input-group">
                                                @Html.PasswordFor(x => x.CurrentPassword, new { @class = "form-control", placeholder = "Enter current password" })
                                            </div>
                                            @Html.ValidationMessageFor(x => x.CurrentPassword, null, new { @class = "red" })
                                        </div>

                                        <!-- New Password (no toggle) -->
                                        <div class="form-group mb-2">
                                            <label for="newPassword" class="form-label">New Password<span class="required">&nbsp;*</span> </label>
                                            <div class="input-group">
                                                @Html.PasswordFor(x => x.NewPassword, new { @class = "form-control", placeholder = "Enter new password" })
                                            </div>
                                            @Html.ValidationMessageFor(x => x.NewPassword, null, new { @class = "red" })
                                        </div>
                                        <div class="form-group mb-2">
                                            <label for="confirmPassword" class="form-label">Confirm Password<span class="required">&nbsp;*</span> </label>
                                            <div class="input-group password-input-wraper">
                                                @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control password-input", type = "Password", placeholder = "Confirm Password here..." })
                                                <i class="fas fa-eye view-password"></i>
                                            </div>
                                            @Html.ValidationMessageFor(x => x.ConfirmPassword, null, new { @class = "red" })
                                        </div>
                                        <div class="form-group mb-0 row login-wrapper">
                                            <div class="col-12">
                                                <input type="hidden" name="ReturnUrl" value="@Request.QueryString["ReturnUrl"]" />
                                                @*<button type="submit" class="w-100 mb-2 btn-set-default">Submit</button>*@
                                                <button type="submit" class="btn login-btn w-100 mb-4 btn-set-default">Submit</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Font Awesome for eye icon (if not already included) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<!-- jQuery (required for the script) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Script to toggle Confirm Password only -->
<script type="text/javascript">
    $(document).ready(function () {
        $(".view-password").click(function () {
            var $icon = $(this);
            var $input = $icon.closest(".input-group").find(".password-input");

            // Toggle input type
            var type = $input.attr("type") === "password" ? "text" : "password";
            $input.attr("type", type);

            // Toggle icon
            $icon.toggleClass("fa-eye fa-eye-slash");
        });
    });
</script>
