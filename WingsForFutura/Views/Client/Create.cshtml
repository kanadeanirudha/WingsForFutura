@using Coditech.ViewModel
@model ClientMasterViewModel

@{
    ViewBag.Title = Model.UserMasterId > 0 ? "View Details" : "";
    string actionName = ViewContext.Controller.ValueProvider.GetValue("action").RawValue.ToString();
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
}

<div class="container-fluid add-product-wrapper main-content-wrapper mt-4">
    <div class="row">
        <div class="col-lg-1"></div>
        <div class="col-lg-12 d-flex align-items-center justify-content-center right-side">
            <div class="list-wrapper">
                <div class="align-items-center d-flex justify-content-between wrapper-header mb-3">
                    @if (Model.UserMasterId > 0)
                    {
                        <h1 class="text-center font-poppins">Update Client</h1>
                    }
                    else
                    {
                        <h1 class="text-center font-poppins">Add New Client</h1>
                    }
                    <div class="align-items-center d-flex justify-content-between gap-10">
                        <a class="btn btn-set-default add-new-product base-font-size" href="../@controllerName/List">
                            <i class="fa fa-arrow-circle-left" aria-hidden="true"></i> Back
                        </a>
                    </div>
                </div>

                <div class="form-wrapper">
                    <div class="row mb-lg-4">
                        <div class="col-lg-12 mb-4 mb-lg-0">
                            @using (Html.BeginForm(actionName, controllerName, FormMethod.Post))
                            {
                                @Html.HiddenFor(x => x.UserMasterId)
                                <div class="form-3-wrapper">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-item-wrapper mb-3">
                                                <label class="form-label">First Name<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(x => x.FirstName, null, new { @class = "red" })
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-item-wrapper mb-3">
                                                <label class="form-label">Middle Name</label>
                                                @Html.TextBoxFor(x => x.MiddleName, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(x => x.MiddleName, null, new { @class = "red" })
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-item-wrapper mb-3">
                                                <label class="form-label">Last Name<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(x => x.LastName, null, new { @class = "red" })
                                            </div>
                                        </div>
                                        @{
                                            var currentYear = DateTime.Now.Year;
                                            var minDate = new DateTime(currentYear - 2, 1, 1).ToString("yyyy-MM-dd");
                                            var maxDate = new DateTime(currentYear + 2, 12, 31).ToString("yyyy-MM-dd");
                                        }
                                        <div class="col-md-6">
                                            <div class="form-item-wrapper mb-4">
                                                <label class="form-label">Date Of Birth<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.DOB, "{0:yyyy-MM-dd}", new
                                                {
                                                    @class = "form-control",
                                                    @type = "date",
                                                    min = minDate,
                                                    max = maxDate
                                                })
                                                @Html.ValidationMessageFor(x => x.DOB, null, new { @class = "red" })
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-item-wrapper mb-4">
                                                <label class="form-label">Nationality<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.Nationality, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(x => x.Nationality, null, new { @class = "red" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-item-wrapper mb-4">
                                                <label class="form-label">Email<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.EmailId, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(x => x.EmailId, null, new { @class = "red" })
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-item-wrapper mb-4">
                                                <label class="form-label">Mobile Number<span class="required"> *</span></label>
                                                @Html.TextBoxFor(x => x.MobileNumber, new { @class = "form-control", maxlength = "10" })
                                                @Html.ValidationMessageFor(x => x.MobileNumber, null, new { @class = "red" })
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-item-wrapper mb-4">
                                                <div class="custom-control custom-checkbox mt-4">
                                                    @Html.CheckBoxFor(x => x.IsActive, new { @class = "custom-control-input", @id = "isActive" })
                                                    <label class="custom-control-label base-font-size" for="isActive">Is Active</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="align-items-center d-flex form-action justify-content-center mt-4">
                                    <button type="submit" class="btn login-btn btn-set-default">Save</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
